# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Must be identical across all Airflow components (webserver, scheduler) or
# task log fetching fails with 403. Generate with:
# python -c "import secrets; print(secrets.token_hex(30))"
AIRFLOW_WEBSERVER_SECRET_KEY=

GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_ID=earthquakes

# Absolute path to your service account JSON on the host machine
GCP_CREDENTIALS_PATH=./keys/gcp-credentials.json
